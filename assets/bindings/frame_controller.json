{
  "action_manifest_version": 2,
  "alias_info": {},
  "app_key": "local.frame.passthrough.shortcuts",
  "bindings": {
    "/actions/shortcuts": {
      "chords": [],
      "haptics": [],
      "poses": [],
      "skeleton": [],
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "button",
          "parameters": {
            "double_press_delay": 0.25
          },
          "inputs": {
            "double": {
              "output": "/actions/shortcuts/in/toggle_style"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "button",
          "parameters": {
            "double_press_delay": 0.25
          },
          "inputs": {
            "double": {
              "output": "/actions/shortcuts/in/toggle_style"
            }
          }
        }
      ]
    }
  },
  "controller_type": "frame_controller",
  "description": "Double-press either thumbstick to toggle translucent / opaque passthrough.",
  "name": "Frame Passthrough Shortcuts - thumbstick gestures",
  "options": {},
  "simulated_actions": []
}
