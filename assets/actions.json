{
  "version": 2,
  "minimum_required_version": 1,
  "action_sets": [
    {
      "name": "/actions/shortcuts",
      "usage": "leftright"
    }
  ],
  "actions": [
    {
      "name": "/actions/shortcuts/in/toggle_style",
      "type": "boolean",
      "requirement": "optional"
    },
    {
      "name": "/actions/shortcuts/in/translucent",
      "type": "boolean",
      "requirement": "optional"
    },
    {
      "name": "/actions/shortcuts/in/opaque",
      "type": "boolean",
      "requirement": "optional"
    }
  ],
  "default_bindings": [
    {
      "controller_type": "frame_controller",
      "binding_url": "bindings/frame_controller.json"
    },
    {
      "controller_type": "frame_hmd",
      "binding_url": "bindings/frame_hmd.json"
    }
  ],
  "localization": [
    {
      "language_tag": "en_us",
      "/actions/shortcuts": "Passthrough shortcuts",
      "/actions/shortcuts/in/toggle_style": "Toggle translucent / opaque",
      "/actions/shortcuts/in/translucent": "Use translucent passthrough",
      "/actions/shortcuts/in/opaque": "Use opaque passthrough"
    }
  ]
}
